<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16" stylesheets="@../css/style.css" style="-fx-background-color: white; -fx-padding: 24;"
      xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.parcauto.controller.VehiculeFormController">

    <Label fx:id="lblTitreFormulaire" text="Ajouter un véhicule" styleClass="form-section-title" style="-fx-font-size: 20px;" />
    <Label text="(*) Champs obligatoires." wrapText="true" style="-fx-text-fill: #686868; -fx-font-size: 13px;" />

    <GridPane hgap="16" vgap="12">
        <columnConstraints>
            <ColumnConstraints percentWidth="50" />
            <ColumnConstraints percentWidth="50" />
        </columnConstraints>

        <Label text="Immatriculation *" styleClass="form-label" GridPane.rowIndex="0" GridPane.columnIndex="0" />
        <TextField fx:id="txtImmatriculation" promptText="Ex : 1234 TBA" GridPane.rowIndex="1" GridPane.columnIndex="0" />

        <Label text="Marque *" styleClass="form-label" GridPane.rowIndex="0" GridPane.columnIndex="1" />
        <TextField fx:id="txtMarque" promptText="Ex : Toyota" GridPane.rowIndex="1" GridPane.columnIndex="1" />

        <Label text="Modèle *" styleClass="form-label" GridPane.rowIndex="2" GridPane.columnIndex="0" />
        <TextField fx:id="txtModele" promptText="Ex : Hilux" GridPane.rowIndex="3" GridPane.columnIndex="0" />

        <Label text="Type de véhicule *" styleClass="form-label" GridPane.rowIndex="2" GridPane.columnIndex="1" />
        <ComboBox fx:id="cmbType" maxWidth="Infinity" GridPane.rowIndex="3" GridPane.columnIndex="1" />

        <Label text="Année" styleClass="form-label" GridPane.rowIndex="4" GridPane.columnIndex="0" />
        <TextField fx:id="txtAnnee" promptText="Ex : 2022" GridPane.rowIndex="5" GridPane.columnIndex="0" />

        <Label text="Kilométrage (km) *" styleClass="form-label" GridPane.rowIndex="4" GridPane.columnIndex="1" />
        <TextField fx:id="txtKilometrage" promptText="Ex : 45000" GridPane.rowIndex="5" GridPane.columnIndex="1" />

        <Label text="Date d'acquisition" styleClass="form-label" GridPane.rowIndex="6" GridPane.columnIndex="0" />
        <DatePicker fx:id="datePickerAcquisition" maxWidth="Infinity" GridPane.rowIndex="7" GridPane.columnIndex="0" />

        <Label text="Prix d'achat (Ar)" styleClass="form-label" GridPane.rowIndex="6" GridPane.columnIndex="1" />
        <TextField fx:id="txtPrixAchat" promptText="Ex : 35000000" GridPane.rowIndex="7" GridPane.columnIndex="1" />
    </GridPane>

    <Label fx:id="lblErreur" text="" wrapText="true" style="-fx-text-fill: #202020; -fx-font-size: 14px; -fx-font-weight: bold;" />

    <Region VBox.vgrow="ALWAYS" />

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Annuler" styleClass="btn-secondary" onAction="#annuler" />
        <Button fx:id="btnEnregistrer" text="Enregistrer" styleClass="btn-primary" onAction="#enregistrer" />
    </HBox>

    <padding>
        <Insets top="4" right="4" bottom="4" left="4" />
    </padding>
</VBox>
