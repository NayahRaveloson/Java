<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16" stylesheets="@../css/style.css" style="-fx-background-color: white; -fx-padding: 24;"
      xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.parcauto.controller.AffectationFormController">

    <Label fx:id="lblTitreFormulaire" text="Nouvelle affectation" styleClass="form-section-title" style="-fx-font-size: 20px;" />
    <Label text="Les champs marqués * sont obligatoires." style="-fx-text-fill: #686868; -fx-font-size: 13px;" />

    <GridPane hgap="16" vgap="12">
        <columnConstraints>
            <ColumnConstraints percentWidth="50" />
            <ColumnConstraints percentWidth="50" />
        </columnConstraints>

        <Label text="Véhicule *" styleClass="form-label" GridPane.rowIndex="0" GridPane.columnIndex="0" />
        <ComboBox fx:id="cmbVehicule" maxWidth="Infinity" promptText="Choisir un véhicule" GridPane.rowIndex="1" GridPane.columnIndex="0" />

        <Label text="Conducteur *" styleClass="form-label" GridPane.rowIndex="0" GridPane.columnIndex="1" />
        <ComboBox fx:id="cmbConducteur" maxWidth="Infinity" promptText="Choisir un conducteur" GridPane.rowIndex="1" GridPane.columnIndex="1" />

        <Label text="Date de début *" styleClass="form-label" GridPane.rowIndex="2" GridPane.columnIndex="0" />
        <DatePicker fx:id="datePickerDebut" maxWidth="Infinity" GridPane.rowIndex="3" GridPane.columnIndex="0" />

        <Label text="Date de fin (facultatif)" styleClass="form-label" GridPane.rowIndex="2" GridPane.columnIndex="1" />
        <DatePicker fx:id="datePickerFin" maxWidth="Infinity" GridPane.rowIndex="3" GridPane.columnIndex="1" />
    </GridPane>

    <Label text="Remarque" styleClass="form-label" />
    <TextArea fx:id="txtRemarque" promptText="Ex : mission régionale, remplacement temporaire..." prefRowCount="3" wrapText="true" />

    <Label fx:id="lblErreur" text="" wrapText="true" style="-fx-text-fill: #202020; -fx-font-size: 14px; -fx-font-weight: bold;" />

    <Region VBox.vgrow="ALWAYS" />

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Annuler" styleClass="btn-secondary" onAction="#annuler" />
        <Button text="Valider l'affectation" styleClass="btn-primary" onAction="#enregistrer" />
    </HBox>

    <padding>
        <Insets top="4" right="4" bottom="4" left="4" />
    </padding>
</VBox>
