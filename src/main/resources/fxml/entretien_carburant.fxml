<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.parcauto.controller.EntretienCarburantController">

    <!-- ===================== CARTES RÉSUMÉ ===================== -->
    <HBox spacing="16">
        <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS" maxWidth="Infinity">
            <Label text="COÛT TOTAL ENTRETIENS" styleClass="kpi-title" />
            <Label fx:id="lblTotalEntretiens" text="0 Ar" styleClass="kpi-value" />
        </VBox>
        <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS" maxWidth="Infinity">
            <Label text="COÛT TOTAL CARBURANT" styleClass="kpi-title" />
            <Label fx:id="lblTotalCarburant" text="0 Ar" styleClass="kpi-value" />
        </VBox>
        <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS" maxWidth="Infinity">
            <Label text="COÛT D'EXPLOITATION TOTAL" styleClass="kpi-title" />
            <Label fx:id="lblTotalGlobal" text="0 Ar" styleClass="kpi-value" />
        </VBox>
    </HBox>

    <TabPane VBox.vgrow="ALWAYS" tabClosingPolicy="UNAVAILABLE">

        <!-- ===================== ONGLET ENTRETIENS ===================== -->
        <Tab text="Entretiens">
            <VBox spacing="14" style="-fx-padding: 12 0 0 0;">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <TextField fx:id="txtRechercheEntretien" promptText="Rechercher par immatriculation ou type..." HBox.hgrow="ALWAYS" />
                    <Button text="Effacer" styleClass="btn-secondary" onAction="#effacerRechercheEntretien" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button text="Ajouter" styleClass="btn-success" onAction="#ouvrirFormulaireAjoutEntretien" />
                    <Button text="Modifier" styleClass="btn-warning" onAction="#ouvrirFormulaireModificationEntretien" />
                    <Button text="Supprimer" styleClass="btn-danger" onAction="#supprimerEntretien" />
                </HBox>

                <TableView fx:id="tableEntretiens" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colEntVehicule" text="Véhicule" prefWidth="120" />
                        <TableColumn fx:id="colEntType" text="Type" prefWidth="130" />
                        <TableColumn fx:id="colEntDate" text="Date" prefWidth="100" />
                        <TableColumn fx:id="colEntKm" text="Kilométrage" prefWidth="100" />
                        <TableColumn fx:id="colEntCout" text="Coût (Ar)" prefWidth="100" />
                        <TableColumn fx:id="colEntDescription" text="Description" prefWidth="220" />
                    </columns>
                </TableView>
            </VBox>
        </Tab>

        <!-- ===================== ONGLET CARBURANT ===================== -->
        <Tab text="Carburant">
            <VBox spacing="14" style="-fx-padding: 12 0 0 0;">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <TextField fx:id="txtRechercheCarburant" promptText="Rechercher par immatriculation..." HBox.hgrow="ALWAYS" />
                    <Button text="Effacer" styleClass="btn-secondary" onAction="#effacerRechercheCarburant" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button text="Ajouter" styleClass="btn-success" onAction="#ouvrirFormulaireAjoutCarburant" />
                    <Button text="Modifier" styleClass="btn-warning" onAction="#ouvrirFormulaireModificationCarburant" />
                    <Button text="Supprimer" styleClass="btn-danger" onAction="#supprimerCarburant" />
                </HBox>

                <TableView fx:id="tableCarburant" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colCarVehicule" text="Véhicule" prefWidth="130" />
                        <TableColumn fx:id="colCarDate" text="Date du plein" prefWidth="110" />
                        <TableColumn fx:id="colCarQuantite" text="Quantité (L)" prefWidth="100" />
                        <TableColumn fx:id="colCarCout" text="Coût (Ar)" prefWidth="100" />
                        <TableColumn fx:id="colCarKm" text="Kilométrage" prefWidth="110" />
                    </columns>
                </TableView>
            </VBox>
        </Tab>

    </TabPane>
</VBox>
