<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.parcauto.controller.DocumentController">

    <HBox spacing="10" alignment="CENTER_LEFT">
        <TextField fx:id="txtRecherche" promptText="Rechercher par immatriculation, type, référence..." HBox.hgrow="ALWAYS" />
        <Button text="Effacer" styleClass="btn-secondary" onAction="#effacerRecherche" />
        <Region HBox.hgrow="ALWAYS" />
        <Button text="Ajouter" styleClass="btn-success" onAction="#ouvrirFormulaireAjout" />
        <Button text="Modifier" styleClass="btn-warning" onAction="#ouvrirFormulaireModification" />
        <Button text="Supprimer" styleClass="btn-danger" onAction="#supprimerDocument" />
    </HBox>

    <Label fx:id="lblCompteur" text="0 document(s)" style="-fx-text-fill: #686868; -fx-font-size: 14px;" />

    <TableView fx:id="tableDocuments" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colVehicule" text="Véhicule" prefWidth="120" />
            <TableColumn fx:id="colType" text="Type de document" prefWidth="140" />
            <TableColumn fx:id="colDateDebut" text="Date début" prefWidth="100" />
            <TableColumn fx:id="colDateExpiration" text="Date d'expiration" prefWidth="120" />
            <TableColumn fx:id="colReference" text="Référence" prefWidth="140" />
            <TableColumn fx:id="colStatutConformite" text="Statut" prefWidth="120" />
        </columns>
    </TableView>

</VBox>
