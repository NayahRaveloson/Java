<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.parcauto.controller.MainController"
            stylesheets="@../css/style.css">

    <left>
        <VBox styleClass="sidebar" spacing="4">
            <padding>
                <Insets top="20" right="0" bottom="20" left="0" />
            </padding>

            <VBox spacing="2" style="-fx-padding: 0 20 24 20;">
                <Label text="Gestion Parc Auto" styleClass="sidebar-app-title" wrapText="true" />
                <Label text="Suivi de flotte" styleClass="sidebar-app-subtitle" />
            </VBox>

            <Label text="NAVIGATION" styleClass="sidebar-section-label" style="-fx-padding: 4 20;" />

            <VBox spacing="2" style="-fx-padding: 4 8;">
                <Button fx:id="btnDashboard" text="Tableau de bord" styleClass="nav-button, nav-button-active" onAction="#afficherDashboard" />
                <Button fx:id="btnVehicules" text="Véhicules" styleClass="nav-button" onAction="#afficherVehicules" />
                <Button fx:id="btnConducteurs" text="Conducteurs" styleClass="nav-button" onAction="#afficherConducteurs" />
                <Button fx:id="btnAffectations" text="Affectations" styleClass="nav-button" onAction="#afficherAffectations" />
                <Button fx:id="btnEntretiens" text="Entretiens &amp; Carburant" styleClass="nav-button" onAction="#afficherEntretiens" />
                <Button fx:id="btnDocuments" text="Documents admin." styleClass="nav-button" onAction="#afficherDocuments" />
            </VBox>
        </VBox>
    </left>

    <top>
        <HBox styleClass="top-bar" alignment="CENTER_LEFT" spacing="8">
            <VBox>
                <Label fx:id="lblTitreEcran" text="Tableau de bord" styleClass="top-bar-title" />
                <Label fx:id="lblSousTitreEcran" text="Vue d'ensemble du parc automobile" styleClass="top-bar-subtitle" />
            </VBox>
        </HBox>
    </top>

    <center>
        <StackPane fx:id="contentArea" styleClass="content-area" />
    </center>

</BorderPane>
