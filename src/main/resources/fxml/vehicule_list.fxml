<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.parcauto.controller.VehiculeController">

    <HBox spacing="10" alignment="CENTER_LEFT">
        <TextField fx:id="txtRecherche" promptText="Rechercher par immatriculation, marque, modèle..." HBox.hgrow="ALWAYS" />
        <ComboBox fx:id="cmbFiltreStatut" promptText="Tous les statuts" />
        <Button text="Effacer" styleClass="btn-secondary" onAction="#effacerRecherche" />
        <Region HBox.hgrow="ALWAYS" />
        <Button text="Ajouter" styleClass="btn-success" onAction="#ouvrirFormulaireAjout" />
        <Button text="Modifier" styleClass="btn-warning" onAction="#ouvrirFormulaireModification" />
        <Button text="Supprimer" styleClass="btn-danger" onAction="#supprimerVehicule" />
    </HBox>

    <Label fx:id="lblCompteur" text="0 véhicule(s)" style="-fx-text-fill: #686868; -fx-font-size: 14px;" />

    <TableView fx:id="tableVehicules" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colImmat" text="Immatriculation" prefWidth="120" />
            <TableColumn fx:id="colMarque" text="Marque" prefWidth="100" />
            <TableColumn fx:id="colModele" text="Modèle" prefWidth="120" />
            <TableColumn fx:id="colType" text="Type" prefWidth="100" />
            <TableColumn fx:id="colAnnee" text="Année" prefWidth="70" />
            <TableColumn fx:id="colKm" text="Kilométrage" prefWidth="100" />
            <TableColumn fx:id="colStatut" text="Statut" prefWidth="120" />
        </columns>
    </TableView>

</VBox>
