<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16" stylesheets="@../css/style.css" style="-fx-background-color: white; -fx-padding: 24;"
      xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.parcauto.controller.CarburantFormController">

    <Label fx:id="lblTitreFormulaire" text="Ajouter un plein" styleClass="form-section-title" style="-fx-font-size: 20px;" />
    <Label text="(*) Champs obligatoires." style="-fx-text-fill: #686868; -fx-font-size: 12px;" />

    <GridPane hgap="16" vgap="12">
        <columnConstraints>
            <ColumnConstraints percentWidth="50" />
            <ColumnConstraints percentWidth="50" />
        </columnConstraints>

        <Label text="Véhicule *" styleClass="form-label" GridPane.rowIndex="0" GridPane.columnIndex="0" />
        <ComboBox fx:id="cmbVehicule" maxWidth="Infinity" promptText="Choisir un véhicule" GridPane.rowIndex="1" GridPane.columnIndex="0" />

        <Label text="Date du plein (automatique)" styleClass="form-label" GridPane.rowIndex="0" GridPane.columnIndex="1" />
        <DatePicker fx:id="datePickerDate" styleClass="field-calculated" maxWidth="Infinity" GridPane.rowIndex="1" GridPane.columnIndex="1" />

        <Label text="Niveau de plein *" styleClass="form-label" GridPane.rowIndex="2" GridPane.columnIndex="0" />
        <ComboBox fx:id="cmbNiveauPlein" maxWidth="Infinity" promptText="Choisir un niveau" GridPane.rowIndex="3" GridPane.columnIndex="0" />

        <Label text="Kilométrage" styleClass="form-label" GridPane.rowIndex="2" GridPane.columnIndex="1" />
        <TextField fx:id="txtKilometrage" promptText="Ex : 44500" GridPane.rowIndex="3" GridPane.columnIndex="1" />

        <Label text="Quantité (litres) *" styleClass="form-label" GridPane.rowIndex="4" GridPane.columnIndex="0" />
        <TextField fx:id="txtQuantite" promptText="Suggérée automatiquement" GridPane.rowIndex="5" GridPane.columnIndex="0" />

        <Label text="Coût (Ar) : calculé automatiquement" styleClass="form-label" GridPane.rowIndex="4" GridPane.columnIndex="1" />
        <TextField fx:id="txtCout" styleClass="field-calculated" promptText="Calculé automatiquement" GridPane.rowIndex="5" GridPane.columnIndex="1" />
    </GridPane>

    <Label fx:id="lblErreur" text="" wrapText="true" style="-fx-text-fill: #202020; -fx-font-size: 14px; -fx-font-weight: bold;" />

    <Region VBox.vgrow="ALWAYS" />

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Annuler" styleClass="btn-secondary" onAction="#annuler" />
        <Button text="Enregistrer" styleClass="btn-primary" onAction="#enregistrer" />
    </HBox>

    <padding>
        <Insets top="4" right="4" bottom="4" left="4" />
    </padding>
</VBox>
