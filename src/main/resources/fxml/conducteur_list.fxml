<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.parcauto.controller.ConducteurController">

    <HBox spacing="10" alignment="CENTER_LEFT">
        <TextField fx:id="txtRecherche" promptText="Rechercher par nom, prénom, n° de permis..." HBox.hgrow="ALWAYS" />
        <Button text="Effacer" styleClass="btn-secondary" onAction="#effacerRecherche" />
        <Region HBox.hgrow="ALWAYS" />
        <Button text="Ajouter" styleClass="btn-success" onAction="#ouvrirFormulaireAjout" />
        <Button text="Modifier" styleClass="btn-warning" onAction="#ouvrirFormulaireModification" />
        <Button text="Supprimer" styleClass="btn-danger" onAction="#supprimerConducteur" />
    </HBox>

    <Label fx:id="lblCompteur" text="0 conducteur(s)" style="-fx-text-fill: #686868; -fx-font-size: 14px;" />

    <TableView fx:id="tableConducteurs" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colNom" text="Nom" prefWidth="130" />
            <TableColumn fx:id="colPrenom" text="Prénom" prefWidth="130" />
            <TableColumn fx:id="colPermis" text="N° Permis" prefWidth="140" />
            <TableColumn fx:id="colTelephone" text="Téléphone" prefWidth="130" />
            <TableColumn fx:id="colDateEmbauche" text="Date d'embauche" prefWidth="130" />
        </columns>
    </TableView>

</VBox>
